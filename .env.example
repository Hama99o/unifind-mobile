# Copy to .env and fill. For Expo Go on a phone, set HOST_IP to this machine's
# LAN IP (ip route get 1.1.1.1 | grep -oP 'src \K[\d.]+').
HOST_IP=192.168.1.10

# Backends (default to staging; override for local backends)
EXPO_PUBLIC_NODE_API_URL=https://api-stg.unifind-lb.org/api
# Strapi CMS catalog is a SEPARATE host (not the Node API). Prod CMS serves draft data.
EXPO_PUBLIC_STRAPI_API_URL=https://cms.unifind.online

# Auth0 (public client config only — NEVER put the client secret here)
EXPO_PUBLIC_AUTH0_DOMAIN=dev-gim0725gfieuvjxt.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=lx7YKrGuk3trDoIhNESkkbxqseU7Nbpr
EXPO_PUBLIC_AUTH0_AUDIENCE=https://dev-gim0725gfieuvjxt.us.auth0.com/api/v2/

EXPO_PUBLIC_APP_NAME=UniFind
EXPO_PUBLIC_DEFAULT_LANG=en
EXPO_PUBLIC_DEFAULT_THEME=system
EXPO_PUBLIC_DEV_PORT=3010

# FlowApp (MultiMagics) — Kanban flow tracking (project 6). Usually set in ~/.bashrc,
# not here. Used by agents to move cards. NOT an Expo public var (no EXPO_PUBLIC_).
# FLOWAPP_API_KEY=fa_xxx

# Strapi public read-only Bearer token (AUTH_SECURITY §6 — treat as public,
# never use for writes; rotate periodically; long-term fix = server-side proxy)
EXPO_PUBLIC_STRAPI_BEARER=
