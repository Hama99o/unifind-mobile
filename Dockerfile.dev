# syntax=docker/dockerfile:1
# Development only — Expo Go (iOS / Android)
ARG NODE_VERSION=22
FROM node:${NODE_VERSION}-slim AS base

WORKDIR /app

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y git python3 make g++ && \
    rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json* ./
RUN npm install --force

COPY . .

# Metro dev server: 3010 (unifind-mobile's dedicated port — see docker-compose).
EXPOSE 3010

# Overridden by docker-compose command (adds --clear --offline --go).
CMD ["npx", "expo", "start", "--port", "3010", "--offline", "--go"]
