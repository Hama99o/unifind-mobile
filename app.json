{
  "expo": {
    "name": "UniFind",
    "slug": "unifind-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "unifind",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logos/unifind-logo-prussian.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.unifind.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "org.unifind.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/logos/unifind-mark.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
