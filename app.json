{
  "expo": {
    "name": "UniFind",
    "slug": "unifind-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "unifind",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.unifind.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "org.unifind.app",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
